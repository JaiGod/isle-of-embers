; Engine configuration file.
; Isle of Embers - Godot 4.3 (Compatibility renderer)

config_version=5

[application]

config/name="Isle of Embers"
config/description="Top-down survival crafting: gather, craft, build, survive the night raids and light the signal beacon."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.07, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.06, 0.13, 0.25, 1)
